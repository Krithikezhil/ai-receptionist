# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file — see SECURITY.md.
#
# M1 note: most of the integrations below are NOT implemented yet. Their
# variables are placeholders reserved for the milestones listed in
# IMPLEMENTATION_PLAN.md, so that the eventual config surface is documented
# up front. Leaving them unset does not break M1.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# apps/web (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------
API_PORT=4000
LOG_LEVEL=info
# Origin allowed to call the API (CORS). Set to the deployed web app URL in prod.
WEB_ORIGIN=http://localhost:3000

# Postgres — provisioned in infrastructure/docker/docker-compose.yml.
# Not connected to by any service yet in M1.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_receptionist

# Redis — provisioned in infrastructure/docker/docker-compose.yml.
# Not connected to by any service yet in M1.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# services/voice-agent (Python)
# ---------------------------------------------------------------------------
VOICE_AGENT_PORT=8000
VOICE_AGENT_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Future integrations — NOT IMPLEMENTED in M1 (placeholders only)
# ---------------------------------------------------------------------------

# Auth (M2)
AUTH_SECRET=

# Stripe billing (M11)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Twilio phone/SMS (M5, M9)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# LLM provider for the voice agent (M4)
OPENAI_API_KEY=

# Speech-to-text (M4)
DEEPGRAM_API_KEY=

# Text-to-speech (M4)
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Google Calendar integration (M8)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
