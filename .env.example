# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file — see SECURITY.md.
#
# Note: most of the integrations below are NOT implemented yet. Their
# variables are placeholders reserved for the milestones listed in
# IMPLEMENTATION_PLAN.md, so that the eventual config surface is documented
# up front. AUTH_SECRET (M2, authentication) is the only one required today.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# apps/web (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------
API_PORT=4000
LOG_LEVEL=info
# Origin allowed to call the API (CORS). Set to the deployed web app URL in prod.
WEB_ORIGIN=http://localhost:3000

# Postgres — provisioned in infrastructure/docker/docker-compose.yml.
# Used by apps/api for auth (users, sessions) as of M2. Requires Docker/a
# real Postgres instance to actually connect — see DEPLOYMENT.md.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_receptionist

# Redis — provisioned in infrastructure/docker/docker-compose.yml.
# Not connected to by any service yet.
REDIS_URL=redis://localhost:6379

# Required. Used as an HMAC "pepper" mixed into password hashing (see
# SECURITY.md) — the API refuses to start without this set. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Optional session cookie tuning — defaults shown.
# SESSION_COOKIE_NAME=ai_receptionist_session
# SESSION_TTL_DAYS=30

# ---------------------------------------------------------------------------
# services/voice-agent (Python)
# ---------------------------------------------------------------------------
VOICE_AGENT_PORT=8000
VOICE_AGENT_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Future integrations — NOT IMPLEMENTED yet (placeholders only)
# ---------------------------------------------------------------------------

# Stripe billing (M11)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Twilio phone/SMS (M5, M9)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# LLM provider for the voice agent (M4)
OPENAI_API_KEY=

# Speech-to-text (M4)
DEEPGRAM_API_KEY=

# Text-to-speech (M4)
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Google Calendar integration (M8)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
