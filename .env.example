# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file — see SECURITY.md.
#
# Note: most of the integrations below are NOT implemented yet. Their
# variables are placeholders reserved for the milestones listed in
# IMPLEMENTATION_PLAN.md, so that the eventual config surface is documented
# up front. AUTH_SECRET (M2, authentication) and INTERNAL_SERVICE_KEY (M5,
# service-to-service auth) are the only two required today.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# apps/web (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------
API_PORT=4000
LOG_LEVEL=info
# Origin allowed to call the API (CORS). Set to the deployed web app URL in prod.
WEB_ORIGIN=http://localhost:3000

# Postgres — provisioned in infrastructure/docker/docker-compose.yml.
# Used by apps/api for auth (users, sessions) as of M2. Requires Docker/a
# real Postgres instance to actually connect — see DEPLOYMENT.md.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_receptionist

# Redis — provisioned in infrastructure/docker/docker-compose.yml.
# Not connected to by any service yet.
REDIS_URL=redis://localhost:6379

# Required. Used as an HMAC "pepper" mixed into password hashing (see
# SECURITY.md) — the API refuses to start without this set. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Optional session cookie tuning — defaults shown.
# SESSION_COOKIE_NAME=ai_receptionist_session
# SESSION_TTL_DAYS=30

# Required. Shared secret for service-to-service auth on /internal/v1/* —
# the same value must be set on both apps/api and services/voice-agent (see
# below). The API refuses to start without this set. Generate with:
#   openssl rand -hex 32
INTERNAL_SERVICE_KEY=

# Optional (M7). Shared with services/voice-agent -- mints/verifies
# short-lived, call-bound credentials for Twilio-originated sessions (see
# src/auth/call-credential.ts). Only relevant once a phone number is mapped
# to an organization. apps/api falls back to a random per-boot value if
# unset (same fail-closed-not-throwing treatment as INTERNAL_SERVICE_KEY's
# own createApp() fallback) -- never blocks startup, but a credential minted
# before that boot can never verify again. Generate with:
#   openssl rand -hex 32
TWILIO_CALL_CREDENTIAL_SECRET=

# Optional (M8). Selects the embedding provider used for knowledge-chunk
# semantic search. Defaults to "fake" (deterministic, no network) if unset --
# matches every other provider-selection default in this file. "openai" is
# real embedding generation via direct REST (no SDK) and requires
# OPENAI_API_KEY below (the same variable services/voice-agent already reads
# for M5 STT/LLM/TTS -- apps/api reads it too, not a duplicate). See
# ARCHITECTURE.md §15.
# EMBEDDING_PROVIDER=fake

# Real-embedding model selection (M8) -- only read if EMBEDDING_PROVIDER=openai
# above. Defaults to "text-embedding-3-small" (1536 dimensions, matching both
# providers' EMBEDDING_DIMENSIONS) if unset.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# services/voice-agent (Python)
# ---------------------------------------------------------------------------
VOICE_AGENT_PORT=8000
VOICE_AGENT_LOG_LEVEL=info

# Must match apps/api's INTERNAL_SERVICE_KEY above exactly.
INTERNAL_SERVICE_KEY=
# Base URL of apps/api, used to call /internal/v1/*.
API_BASE_URL=http://localhost:4000

# STT/LLM/TTS provider selection for the voice-agent pipeline (M5). Each
# defaults to "fake" (a deterministic, no-network double) if unset — a real
# value here also requires the matching provider API key below. See
# services/voice-agent/README.md.
# STT_PROVIDER=fake
# LLM_PROVIDER=fake
# TTS_PROVIDER=fake

# Real-provider model selection (M6) — each has a default from the installed
# Pipecat SDK, only read if the matching *_PROVIDER above is set to a real
# provider name. See services/voice-agent/README.md.
# DEEPGRAM_MODEL=nova-3-general
# OPENAI_MODEL=gpt-4.1

# Seconds of actual caller silence before a session ends itself by speaking
# the receptionist's fallback message (M6). Defaults to 45 if unset; a
# malformed or non-positive value fails closed at startup.
# VOICE_AGENT_IDLE_TIMEOUT_SECS=45

# Twilio inbound calls (M7). Both optional: the Twilio routes
# (POST /twilio/voice, WS /twilio/media-stream) fail closed per-request if
# either is unset, rather than the whole service refusing to start -- Twilio
# integration is optional per deployment. TWILIO_AUTH_TOKEN verifies
# X-Twilio-Signature. VOICE_AGENT_PUBLIC_BASE_URL is the exact public URL
# Twilio is configured to call -- never derived from request headers -- also
# reused to build the wss:// Media Stream URL in the response TwiML. See
# services/voice-agent/README.md.
# TWILIO_AUTH_TOKEN=
# VOICE_AGENT_PUBLIC_BASE_URL=https://your-public-host.example.com

# ---------------------------------------------------------------------------
# STT/LLM/TTS provider keys (M5) — OPTIONAL. Only read if the matching
# STT_PROVIDER/LLM_PROVIDER/TTS_PROVIDER above is set to a real provider
# name; with the default "fake" providers, none of these are needed to run
# the service or its tests. Not used by CI under any configuration.
# OPENAI_API_KEY is also read by apps/api's EMBEDDING_PROVIDER=openai (M8,
# above) -- the same key, not a duplicate variable.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Required if TTS_PROVIDER=cartesia (M6) — Cartesia has no default voice;
# unlike the keys above, this is not optional once Cartesia is selected.
# Get a voice id from your Cartesia account.
CARTESIA_VOICE_ID=

# ---------------------------------------------------------------------------
# Future integrations — NOT IMPLEMENTED yet (placeholders only)
# ---------------------------------------------------------------------------

# Stripe billing (M13)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Twilio SMS (M11) -- confirmations, reminders, delivery-status webhook,
# and the standalone worker process (npm run worker, src/worker.ts) are
# implemented. TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN/API_PUBLIC_BASE_URL
# must all be set for the worker to run -- it fails closed at startup
# otherwise (see src/worker.ts). TWILIO_AUTH_TOKEN is the SAME credential
# already set above for M7 inbound calls -- Twilio issues one Auth Token
# per account, used both to verify inbound webhook signatures (M7 voice,
# and this worker's own delivery-status webhook,
# controllers/twilio-sms-status.controller.ts) and as the outbound REST
# API's Basic Auth secret (src/services/twilio-sms-client.ts) -- not a
# second variable to set separately. API_PUBLIC_BASE_URL is this API's own
# public URL (distinct from VOICE_AGENT_PUBLIC_BASE_URL above, which is
# voice-agent's own separate service) -- read directly by both the
# delivery-status webhook controller and the worker to build the exact
# same Twilio StatusCallback URL, never derived from a request header.
# TWILIO_PHONE_NUMBER is still not read from environment at all -- the
# worker resolves the outbound sender number per-organization via the
# database (organization_phone_numbers), the same design M7 already
# established, provisioned through
# POST/GET/DELETE /organizations/:id/phone-numbers.
TWILIO_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=
API_PUBLIC_BASE_URL=

# Google Calendar integration (M10). All five vars below are read directly
# via process.env at the point of use (calendar-connection.service.ts,
# calendar-connection.controller.ts, auth/oauth-state.ts,
# google-token-crypto.ts) -- not routed through src/config/env.ts, and not
# asserted at server startup. Google Calendar integration is optional per
# deployment: an organization's owner simply cannot connect a calendar (the
# OAuth start/callback and getAccessToken() calls fail closed with a clear
# error) until all of these are set -- the rest of the API is unaffected.

# OAuth 2.0 client credentials from the Google Cloud Console (APIs &
# Services > Credentials > OAuth client ID > Web application). Required for
# both the authorization-code exchange (connect) and the refresh-token
# exchange (getAccessToken).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# The exact redirect URI registered for the OAuth client above -- must be
# byte-identical in the Google Cloud Console, the authorization request
# (connect), and the token exchange (the callback), or Google rejects the
# exchange. Fixed and organization-agnostic (see src/routes/oauth.routes.ts):
#   GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/oauth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=

# Signs/verifies the short-lived (10 minute) OAuth state token that binds a
# connect attempt to one organization and dashboard user (see
# src/auth/oauth-state.ts). Independent from every other secret in this
# file. Generate with:
#   openssl rand -hex 32
GOOGLE_OAUTH_STATE_SECRET=

# Encrypts each organization's Google refresh token at rest (AES-256-GCM --
# see src/services/google-token-crypto.ts). Must be a base64-encoded
# 32-byte key, e.g. via `openssl rand -base64 32`. Losing or rotating this
# value invalidates every already-connected organization's calendar
# connection (they will need to reconnect) -- key rotation/migration is not
# implemented in M10.
GOOGLE_TOKEN_ENCRYPTION_KEY=
